doctype html
html
  head
    meta(charset='UTF-8')
    title Register Stock - Nyondo Hardware
    link(rel='stylesheet' href='/css/addstock.css')
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css')
    style.
      .invalid-border { border: 2px solid #ff4d4d !important; }
      .hidden { display: none; }
      .error-message-inline { color: #ff4d4d; font-size: 0.75rem; margin-top: 4px; min-height: 1em; }

  body
    .sidebar
      .logo: h2 ⚒ NYONDO HARDWARE
      ul
        li: a(href='storedash') #[i.fas.fa-home.fa-fw] #[span.nav-text Dashboard]
        li: a(href='invento') #[i.fas.fa-boxes.fa-fw] #[span.nav-text Inventory]
        li: a(href='storsales') #[i.fas.fa-cash-register.fa-fw] #[span.nav-text Reports]
        li.active: a(href='addstock') #[i.fas.fa-plus-circle.fa-fw] #[span.nav-text Add Stock]
        li: a(href='logout') #[i.fas.fa-sign-out-alt.fa-fw] #[span.nav-text Logout]
    
    .main
      .header
        h1 #[i.fas.fa-plus-circle] Full Stock Registration
        p Fill in all the details to register new stock items.

      if error
        .error-message#errorMessage
          i.fas.fa-exclamation-circle
          |  #{error}

      form.stock-form(method='POST' action='/addstock' enctype='multipart/form-data')
        h2 Product & Stock Details
        .form-grid-3x3
          .field
            label Product Name
            select(name='productName' required data-custom-error="Please select a product.")
              option(value='') Select Product
              option(value='Cement iiN') Cement iiN
              option(value='Cement iiiN') Cement iiiN
              option(value='Iron Bars 10mm') Iron Bars 10mm
              option(value='Iron Bars 12mm') Iron Bars 12mm
              option(value='Iron Bars 16mm') Iron Bars 16mm
              option(value='Nails 1 Inch') Nails 1 Inch
              option(value='Nails 3 Inch') Nails 3 Inch
              option(value='Nails 4 Inch') Nails 4 Inch
              option(value='Nails 5 Inch') Nails 5 Inch
              option(value='Roofing Nails') Roofing Nails
              option(value='Wheelbarrow') Wheelbarrow
              option(value='Wire Mesh') Wire Mesh
              option(value='Barbed Wire High Tensile') Barbed Wire High Tensile
              option(value='Barbed Wire Low Tensile') Barbed Wire Low Tensile
              option(value='Iron Sheets') Iron Sheets
            .error-message-inline
          .field
            label Category
            select(name='category' required data-custom-error="Please select a category.")
              option(value='') Select Category
              option(value='Building') Building
              option(value='Hardware') Hardware
              option(value='Electrical') Electrical
              option(value='Roofing') Roofing
              option(value='Timber') Timber
            .error-message-inline
          .field
            label Quantity
            input(type='number' name='quantity' min='1' required data-custom-error="Quantity must be at least 1.")
            .error-message-inline
          .field
            label Unit
            select(name='unit')
              option(value=''  disabled selected)
              option(value='Bags') Bags
              option(value='Pieces') Pieces
              option(value='Boxes') Boxes
            .error-message-inline
          .field
            label Buying Price
            input(type='number' name='buyingPrice' id='buyingPrice' min='1' required data-custom-error="Buying price is required.")
            .error-message-inline
          .field
            label Selling Price
            input(type='number' name='sellingPrice' id='sellingPrice' min='1' required data-custom-error="Selling price must be higher than the buying price.")
            .error-message-inline
          .field
            label Payment Method
            select(name='paymentMethod'  id="paymentMethod")
              option(value=''  disabled selected)
              option(value='Cash') Cash
              option(value='Credit') Credit
            .error-message-inline
          .field
            label Payment Status
            select(name='paymentStatus'  id="paymentStatus")
              option(value='' disabled selected)
              option(value='Pending') Not paid
              option(value='Paid') Paid
            .error-message-inline
          .field
            label Supplier Name
            input(type='text' name='supplierName' required data-custom-error="Supplier name is required.")
            .error-message-inline

        h2 Additional Details
        .form-grid-3x3
          .field
            label Supplier Contact
            input(type='text' name='supplierContact' placeholder='07XXXXXXXX' pattern='^(07\\d{8}|\\+256\\d{9})$' required data-custom-error="Format: 07XXXXXXXX or +256XXXXXXXX")
            .error-message-inline
          .field
            label Factory / Depot
            input(type='text' name='factory')
            .error-message-inline
          .field
            label Product Image
            input(type='file' name='itemImage')
            .error-message-inline

        .buttons
          button.btn.save(type='submit') #[i.fas.fa-save] Save All Details
          button.btn.reset(type='reset') #[i.fas.fa-undo] Reset

    script.
      document.addEventListener('input', (e) => {
        const input = e.target;
        if (!input.matches('input, select')) return;

        const errorContainer = input.nextElementSibling;
        const mainError = document.getElementById('errorMessage');
        const buyPrice = document.getElementById('buyingPrice');
        const sellPrice = document.getElementById('sellingPrice');
        
        if (mainError) mainError.classList.add('hidden');

        // Initial validation state
        let isInvalid = !input.checkValidity();
        let message = input.getAttribute('data-custom-error') || input.validationMessage;

        // Custom Rule: If field is required and left empty
        if (input.hasAttribute('required') && input.value.trim() === '') {
          isInvalid = true;
          message = "This field is required.";
        } 
        // Custom Rule: Selling Price must be > Buying Price
        else if (input.id === 'sellingPrice' && buyPrice.value !== '' && Number(sellPrice.value) <= Number(buyPrice.value)) {
          isInvalid = true;
          message = input.getAttribute('data-custom-error');
        }

        // Apply UI Feedback
        if (isInvalid) {
          input.classList.add('invalid-border');
          if (errorContainer) errorContainer.textContent = message;
        } else {
          input.classList.remove('invalid-border');
          if (errorContainer) errorContainer.textContent = '';
        }
      });

     const methodSelect = document.getElementById('paymentMethod');
      const statusSelect = document.getElementById('paymentStatus');

      methodSelect.addEventListener('change', () => {
        if (methodSelect.value === 'Cash') {
          statusSelect.value = 'Paid';
          statusSelect.disabled = true; // Makes the field unchangeable by user
        } else {
          statusSelect.value = 'Pending';
          statusSelect.disabled = false; // Makes it editable for 'Credit'
        }
      });
      
      // This line runs once when the page loads, forcing the logic to check the initial state.
      methodSelect.dispatchEvent(new Event('change'));
            // ========== SUBMIT VALIDATION FOR RED BORDERS ==========
      
      // Force disable browser native validation
      const stockForm = document.querySelector('.stock-form');
      if (stockForm) {
        stockForm.setAttribute('novalidate', true);
        stockForm.noValidate = true;
      }
      
      function addRedBorder(field) {
          field.style.border = "2px solid #ff4d4d";
          field.style.backgroundColor = "#fff8f8";
          field.classList.add('invalid-border');
      }
      
      function removeRedBorder(field) {
          field.style.border = "1px solid #ddd";
          field.style.backgroundColor = "";
          field.classList.remove('invalid-border');
      }
      
      function isEmpty(field) {
          if (field.tagName === 'SELECT') {
              return !field.value || field.value === '';
          }
          return field.value.trim() === '';
      }
      
      function showErrorMessage(field, message) {
          let errorContainer = field.nextElementSibling;
          if (errorContainer && errorContainer.classList.contains('error-message-inline')) {
              errorContainer.textContent = message;
          }
      }
      
      function clearErrorMessage(field) {
          let errorContainer = field.nextElementSibling;
          if (errorContainer && errorContainer.classList.contains('error-message-inline')) {
              errorContainer.textContent = '';
          }
      }
      
      // Validate on submit
      if (stockForm) {
          stockForm.addEventListener('submit', function(e) {
              let isValid = true;
              const allFields = stockForm.querySelectorAll('input:not([type="file"]), select');
              
              allFields.forEach(field => {
                  if (field.disabled) return;
                  
                  if (isEmpty(field)) {
                      isValid = false;
                      addRedBorder(field);
                      
                      let message = '';
                      switch(field.name) {
                          case 'productName': message = 'Please select a product'; break;
                          case 'category': message = 'Please select a category'; break;
                          case 'quantity': message = 'Please enter quantity'; break;
                          case 'buyingPrice': message = 'Please enter buying price'; break;
                          case 'sellingPrice': message = 'Please enter selling price'; break;
                          case 'supplierName': message = 'Please enter supplier name'; break;
                          case 'supplierContact': message = 'Please enter supplier contact'; break;
                          default: message = 'This field is required';
                      }
                      showErrorMessage(field, message);
                  } 
                  else if (field.id === 'sellingPrice') {
                      const buyPrice = document.getElementById('buyingPrice');
                      if (buyPrice && buyPrice.value && parseFloat(field.value) <= parseFloat(buyPrice.value)) {
                          isValid = false;
                          addRedBorder(field);
                          showErrorMessage(field, 'Selling price must be higher than buying price');
                      } else {
                          removeRedBorder(field);
                          clearErrorMessage(field);
                      }
                  }
                  else if (field.pattern && field.pattern.length > 0) {
                      const regex = new RegExp('^' + field.pattern + '$');
                      if (!regex.test(field.value)) {
                          isValid = false;
                          addRedBorder(field);
                          showErrorMessage(field, field.getAttribute('data-custom-error') || 'Invalid format');
                      } else {
                          removeRedBorder(field);
                          clearErrorMessage(field);
                      }
                  }
                  else {
                      removeRedBorder(field);
                      clearErrorMessage(field);
                  }
              });
              
              if (!isValid) {
                  e.preventDefault();
                  const firstError = stockForm.querySelector('.invalid-border');
                  if (firstError) {
                      firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                  }
              }
          });
      }
      
      // Remove red border when user starts typing
      const allFields = document.querySelectorAll('.stock-form input:not([type="file"]), .stock-form select');
      allFields.forEach(field => {
          field.addEventListener('input', function() {
              if (this.value.trim() !== '') {
                  removeRedBorder(this);
                  clearErrorMessage(this);
              }
          });
          field.addEventListener('change', function() {
              if (this.value.trim() !== '') {
                  removeRedBorder(this);
                  clearErrorMessage(this);
              }
          });
          field.addEventListener('focus', function() {
              removeRedBorder(this);
              clearErrorMessage(this);
          });
      });
      
      // Special validation for selling price when buying price changes
      const buyingPrice = document.getElementById('buyingPrice');
      const sellingPrice = document.getElementById('sellingPrice');
      
      if (buyingPrice && sellingPrice) {
          buyingPrice.addEventListener('input', function() {
              if (sellingPrice.value && parseFloat(sellingPrice.value) <= parseFloat(this.value)) {
                  addRedBorder(sellingPrice);
                  showErrorMessage(sellingPrice, 'Selling price must be higher than buying price');
              } else if (sellingPrice.value) {
                  removeRedBorder(sellingPrice);
                  clearErrorMessage(sellingPrice);
              }
          });
          
          sellingPrice.addEventListener('input', function() {
              const buyPrice = document.getElementById('buyingPrice');
              if (buyPrice.value && parseFloat(this.value) <= parseFloat(buyPrice.value)) {
                  addRedBorder(this);
                  showErrorMessage(this, 'Selling price must be higher than buying price');
              } else {
                  removeRedBorder(this);
                  clearErrorMessage(this);
              }
          });
      }
      
      // ========== END OF SUBMIT VALIDATION ==========