doctype html
html
  head
    meta(charset='UTF-8')
    title Update Deposit - Nyondo Hardware
    link(rel='stylesheet' href='/css/editdeposit.css')
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css')
  body
    .sidebar
      .logo ⚒ NYONDO HARDWARE
      ul
        li: a(href='/admindash')
          i.fas.fa-home 
          span Dashboard
        li: a(href='/deposit')
          i.fas.fa-arrow-left 
          span Back
    .main
      h1 Update Payment for Receipt #{d.receiptNumber}

      section.sale-form
        h2 Customer: #{d.customer ? d.customer.fullName : 'Deleted Customer'}
        
        //- ERROR ALERT BOX
        if error
          #errorBox.error-message
            i.fas.fa-circle-exclamation
            span #{error}

        form(action=`/deposit/edit/${d._id}` method='POST' id='editDepositForm')
          
          h3.cart-section-title Items in this Order
          
          //- DYNAMIC CART ARRAY ITEMS ITERATION
          #cartContainer
            if d.items && d.items.length > 0
              each item in d.items
                .cart-item-row
                  .form-group.product-selection-group
                    label Item Profile (Read Only)
                    //- FIX: Hidden input field guarantees array element matching on form processing
                    input(type="hidden" name="itemId" value=(item.productName ? item.productName._id : ''))
                    input.readonly-input(type="text" value=(item.productName ? `${item.productName.productName} (Locked Price: ${item.price.toLocaleString()} UGX)` : 'Item Deleted') readonly)

                  .form-group.quantity-selection-group
                    label Quantity Wanted
                    input.quantity-input(type='number' name='quantity' value=item.quantity min="1" required)
            else
              //- Fallback layer for single legacy records
              .cart-item-row
                .form-group.product-selection-group
                  label Item Profile (Read Only)
                  input.readonly-input(type="text" value=d.productType readonly)
                .form-group.quantity-selection-group
                  label Quantity Wanted
                  input.quantity-input(type='number' name='quantity' min="1" )

          //- NEW INLINE CONTAINER FOR THE LAST THREE ELEMENTS
          .form-inline-footer-group
            hr.thin-divider

            //- 1. PREVIOUS LEDGER STATS: TOTAL PAID
            .form-group.footer-paid-box
              label Current Total Amount Paid (UGX)
              input.readonly-input(type="text" value=d.initialDeposit.toLocaleString() readonly)

            //- 2. PREVIOUS LEDGER STATS: BALANCE DUE
            .form-group.footer-balance-box
              label Current Balance Due
              input.readonly-balance-input(type="text" value=`${d.balance.toLocaleString()} UGX` readonly)

            hr.thick-divider

            //- 3. THE TRANSACTION ENTRY TOP-UP FIELD
            .form-group.footer-topup-box
              label.highlight-label Enter New Money Deposited Today (UGX)
              input(type='number' name='newPayment' value="0" min="0" placeholder="e.g. 50000" required)
              small.text-muted This amount will automatically be added to previous payments, reducing the balance due.

          button.register-btn.btn-update-ledger(type='submit') 
            i.fas.fa-hand-holding-usd
            |  Update Balance

    //- JAVASCRIPT VALIDATION & INTERACTIVE STATE HOOKS
    script.
      document.addEventListener('DOMContentLoaded', () => {
        const errorBox = document.getElementById('errorBox');
        
        // Auto-hide the error banner when the operator adjusts any entry field
        if (errorBox) {
          const formInputs = document.querySelectorAll('input');
          formInputs.forEach(input => {
            input.addEventListener('input', () => {
              errorBox.classList.add('hidden');
            }, { once: true });
            
            input.addEventListener('change', () => {
              errorBox.classList.add('hidden');
            }, { once: true });
          });
        }
      const depositForm = document.getElementById('editDepositForm');
      if (depositForm) {
        depositForm.setAttribute('novalidate', true);
        depositForm.noValidate = true;
      }
      
      function addRedBorder(field) {
          field.style.border = "1px solid #dc2626";
          field.style.backgroundColor = "#fff8f8";
      }
      
      function removeRedBorder(field) {
          field.style.border = "1px solid #ddd";
          field.style.backgroundColor = "";
      }
      
      function showFieldError(field, message) {
          const existingError = field.parentElement.querySelector('.field-error');
          if (existingError) existingError.remove();
          
          const errorSpan = document.createElement('span');
          errorSpan.className = 'field-error';
          errorSpan.style.cssText = 'color: #dc2626; font-size: 12px; margin-top: 5px; display: block;';
          errorSpan.innerHTML = `<i class="fas fa-exclamation-circle" style="margin-right: 5px;"></i>${message}`;
          field.parentElement.appendChild(errorSpan);
      }
      
      function removeFieldError(field) {
          const error = field.parentElement.querySelector('.field-error');
          if (error) error.remove();
      }
      
      // Validate on submit - only quantity
      if (depositForm) {
          depositForm.addEventListener('submit', function(e) {
              let isValid = true;
              const quantityInputs = document.querySelectorAll('.quantity-input');
              
              quantityInputs.forEach(input => {
                  if (!input.value || input.value.trim() === '' || parseInt(input.value) < 1) {
                      isValid = false;
                      addRedBorder(input);
                      showFieldError(input, 'Please enter a valid quantity');
                  } else {
                      removeRedBorder(input);
                      removeFieldError(input);
                  }
              });
              
              if (!isValid) {
                  e.preventDefault();
              }
          });
      }
      
      // Remove red border when user starts typing
      const quantityInputs = document.querySelectorAll('.quantity-input');
      quantityInputs.forEach(input => {
          input.addEventListener('input', function() {
              if (this.value && this.value.trim() !== '' && parseInt(this.value) >= 1) {
                  removeRedBorder(this);
                  removeFieldError(this);
              }
          });
      });
      
      });