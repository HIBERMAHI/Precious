doctype html
html
  head
    title Payment Voucher - #{supplierName}
    link(rel='stylesheet' href='/css/evidence.css')
  body
    .voucher-container
      .header
        h1 PAYMENT VOUCHER
        p NYONDO HARDWARE - Official Settlement Record
      
      .meta
        div
          p #[strong Supplier:] #{supplierName}
          //- Added Supplier Contact display
          if items.length > 0
            p #[strong Contact:] #{items[0].supplierContact}
        div
          p #[strong Date Settled:] #{new Date().toLocaleDateString()}
          //- Added Voucher Number (Batch ID)
          if items.length > 0 && items[0].paymentBatchId
            p #[strong Voucher No:] #{items[0].paymentBatchId}
      
      //- CHECK IF THERE ARE ITEMS TO DISPLAY
      if items && items.length > 0
        table.voucher-table
          thead
            tr
              th Product Name
              th Quantity
              th Price (UGX)
              th Total (UGX)
          tbody
            - var grandTotal = 0
            each item in items
              tr
                td #{item.productName}
                td #{item.initialQuantity}
                td #{item.buyingPrice.toLocaleString()}
                td #{item.total.toLocaleString()}
                - grandTotal += item.total
        
        .total-section
          h2 Grand Total Paid: #{grandTotal.toLocaleString()} UGX
      
      else
        //- SHOW THIS IF NO PAID RECORDS EXIST
        .no-data(style="text-align: center; padding: 40px; color: #777;")
          p No settled payment records found for this supplier.

      .footer
        div
          p Received By: ____________________
        div
          p Authorized Signature: ____________________

      //- Action buttons
      .no-print.actions-area
        hr
        if items && items.length > 0
          button(onclick="window.print()" class="print-btn") Print This Voucher
        a(href="/suppliers" class="back-link") Back to Dashboard