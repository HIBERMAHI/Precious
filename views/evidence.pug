doctype html
html
  head
    title Payment Voucher - #{supplierName}
    link(rel='stylesheet' href='/css/evidence.css')
  body
    .voucher-container
      .header
        h1 PAYMENT VOUCHER
        p NYONDO HARDWARE - Official Settlement Record
      
      .meta
        div
          p #[strong Supplier:] #{supplierName}
          if items.length > 0
            p #[strong Contact:] #{items[0].supplierContact || 'N/A'}
        div
          p #[strong Date Settled:] 
            //- Accessing the date from the first item in the array
            if items.length > 0 && items[0].paymentStatus === 'Paid' && items[0].settlementDate
              | #{new Date(items[0].settlementDate).toLocaleDateString('en-GB')}
            else
              | #[em Not Recorded]
              
          //- Accessing the batch ID from the first item in the array
          if items.length > 0 && items.paymentBatchId
            p #[strong Voucher No:] #{items.paymentBatchId}
      
      if items && items.length > 0
        table.voucher-table
          thead
            tr
              th Product Name
              th Factory
              th Quantity
              th Price (UGX)
              th Total (UGX)
          tbody
            - var grandTotal = 0
            each item in items
              tr
                td #{item.productName}
                td #{item.factory || 'N/A'}
                td #{item.initialQuantity}
                td #{item.buyingPrice.toLocaleString()}
                td #{item.total.toLocaleString()}
                - grandTotal += item.total
        
        - var isPaid = items.every(i => i.paymentStatus === 'Paid')
        
        .total-section
          if isPaid
            h2(style="color: green;") Total Cleared: #{grandTotal.toLocaleString()} UGX
            p(style="color: green; font-weight: bold;") Status: CLEARED
          else
            h2(style="color: red;") Total Pending: #{grandTotal.toLocaleString()} UGX
            p(style="color: red; font-weight: bold;") Status: PENDING
      
      else
        .no-data(style="text-align: center; padding: 40px; color: #777;")
          p No payment records found for this voucher.

      .footer
        div
          p Received By: ____________________
        div
          p Authorized Signature: ____________________

      .no-print.actions-area
        hr
        if items && items.length > 0
          button(onclick="window.print()" class="print-btn") Print This Voucher
        a(href="/suppliers" class="back-link") Back to Dashboard