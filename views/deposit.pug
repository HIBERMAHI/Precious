doctype html
html
  head
    meta(charset='UTF-8')
    title Deposit Scheme - Nyondo Hardware
    link(rel='stylesheet' href='/css/deposit.css')
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css')

  body
    .sidebar
      .logo ⚒ NYONDO HARDWARE
      ul
        li
          a(href='/admindash')
            i.fas.fa-home.fa-fw
            |   Dashboard
        li.active
          a(href='/deposit')
            i.fas.fa-piggy-bank.fa-fw
            span.nav-text Deposit Scheme
        li
          a(href='/regicredit')
            i.fas.fa-user-plus.fa-fw
            span.nav-text Register Customer
        li
          a(href='/logout')
            i.fas.fa-sign-out-alt.fa-fw
            span.nav-text Logout

    .main
      h1 Salary Earner Deposit Scheme

      //- NEW DEPOSIT ENTRY FORM
      section.sale-form
        h2 Record New Transaction
        
        if error
          #errorBox.error-message
            i.fas.fa-circle-exclamation
            span #{error}

        form(action='/deposit' method='POST' id='depositForm')
          
          //- GROUPED HIGHER HEADER ELEMENTS (Aligned inside a single row via CSS layout controls)
          .form-inline-header-group
            .form-group.customer-selection-box
              label Select Registered Customer
              select(name='customerId' required)
                option(value='' disabled selected) -- Choose Customer --
                each c in customers
                  option(value=c._id) #{c.fullName} ({c.address} - #{c.distanceFromStore} KM)
            
            .form-group.deposit-payment-box
              label Initial Deposit Amount (UGX)
              input(type='number' name='initialDeposit' required placeholder="Enter amount paid today" min="0")

            .form-group.live-calculation-box
              label.summary-label Estimated Materials Value
              .total-summary-box
                span.summary-amount#overallOrderTotal 0
                span.summary-currency  UGX
          
          h3.cart-section-title Selected Cart Items
          
          //- THE MULTI-ITEM CART CONTAINER
          #cartContainer
            .cart-item-row
              .form-group.product-selection-group
                label Select Item (Displays Stock & Price)
                select.product-select(name='itemId' required)
                  option(value='' disabled selected) -- Select Product --
                  each item in stockItems
                    if item.quantity > 0
                      option(value=item._id data-price=item.sellingPrice) #{item.productName} (Stock: #{item.quantity} | Price: #{item.sellingPrice.toLocaleString()} UGX)
                    else
                      option(value=item._id disabled) #{item.productName} (OUT OF STOCK)
              
              .form-group.quantity-selection-group
                label Quantity Wanted
                input.quantity-input(type='number' name='quantity' value="1" min="1" required)
              
              button.remove-item-btn(type='button')
                span.btn-text Delete
                  i.fas.fa-trash-alt
                  

          .add-more-container
            button.btn-add-item(type='button' id='addItemBtn')
              i.fas.fa-plus-circle
              |  Add Another Item

          button.register-btn(type='submit') 
            i.fas.fa-file-invoice-dollar
            |  Process & Save Transaction

      //- RETRIEVAL TABLE
      section.recent-sales
        h2 Deposit Records & Balance Tracking
        table
          thead
            tr
              th #
              th Receipt #
              th Customer
              th Distance (KM)
              th Material Name
              th Quantity
              th Total Price
              th Amt Paid
              th Status / Balance
              th Action
          tbody
            if deposits && deposits.length > 0
              each d , index in deposits
                tr
                  td #{index + 1}
                  td.receipt-cell #{d.receiptNumber}
                  td.customer-cell #{d.customer ? d.customer.fullName : 'Deleted'}
                  
                  //- DISTANCE CELL OUTPUT RIGHT AFTER CUSTOMER PROFILE
                  td.distance-cell 
                    if d.customer
                      | #{d.customer.distanceFromStore} Km
                    else
                      | N/A

                  td.items-list-cell
                    if d.items && d.items.length > 0
                      each entry in d.items
                        .cart-item-name-display
                          | #{entry.productName ? entry.productName.productName : 'Item Deleted'}
                    else
                      .cart-item-name-display
                        | #{d.productType || 'N/A'}
                  
                  td.quantity-list-cell
                    if d.items && d.items.length > 0
                      each entry in d.items
                        .cart-qty-display
                          | #{entry.quantity} units
                    else
                      .cart-qty-display
                        | #{d.quantity || 0} units
                  
                  td.total-cell #{d.totalAmount.toLocaleString()}
                  td.paid-cell #{d.initialDeposit.toLocaleString()}
                  
                  td.status-cell
                    if d.balance > 0
                      span.status-pending PENDING: #{d.balance.toLocaleString()} UGX
                    else
                      span.status-completed COMPLETED (0 UGX)

                  td.actions-cell
                    a.action-btn-print(href=`/deposit/receipt/${d._id}` target="_blank" title="Print Receipt")
                      span.action-label  Receipt
                      i.fas.fa-print
                    if d.balance > 0
                     a.action-btn-edit(href=`/deposit/edit/${d._id}` title="Edit Ledger / Pay Balance")
                      span.action-label Edit
                      i.fas.fa-edit
                    
                    form(action=`/deposit/delete/${d._id}` method="POST" onsubmit="return confirm('CORRECTION: Delete this entire transaction record and return all items back to stock inventory?')")
                      button.action-btn-delete(type="submit" title="Delete Record")
                        span.action-label Delete
                        i.fas.fa-trash-alt
            else
              tr
                //- Adjusted colspan to 9 to cleanly match the structural row count balance
                td.empty-table-cell(colspan="10") No deposits recorded yet.

    script.
      document.addEventListener('DOMContentLoaded', () => {
        const cartContainer = document.getElementById('cartContainer');
        const addItemBtn = document.getElementById('addItemBtn');
        const overallOrderTotalText = document.getElementById('overallOrderTotal');
        const errorBox = document.getElementById('errorBox');

        if (errorBox) {
          document.querySelectorAll('input, select').forEach(element => {
            element.addEventListener('input', () => errorBox.classList.add('hidden'), { once: true });
            element.addEventListener('change', () => errorBox.classList.add('hidden'), { once: true });
          });
        }

        function calculateCartTotals() {
          let grandSum = 0;
          const rows = cartContainer.querySelectorAll('.cart-item-row');
          
          rows.forEach(row => {
            const select = row.querySelector('.product-select');
            const qtyInput = row.querySelector('.quantity-input');
            
            const selectedOption = select.options[select.selectedIndex];
            if (selectedOption && selectedOption.value) {
              const unitPrice = parseFloat(selectedOption.getAttribute('data-price')) || 0;
              const qty = parseInt(qtyInput.value) || 0;
              grandSum += (unitPrice * qty);
            }
          });
          overallOrderTotalText.textContent = grandSum.toLocaleString();
        }

        cartContainer.addEventListener('change', (e) => {
          if (e.target.classList.contains('product-select') || e.target.classList.contains('quantity-input')) {
            calculateCartTotals();
          }
        });

        cartContainer.addEventListener('input', (e) => {
          if (e.target.classList.contains('quantity-input')) {
            calculateCartTotals();
          }
        });

        addItemBtn.addEventListener('click', () => {
          const baseRow = cartContainer.querySelector('.cart-item-row');
          const clonedRow = baseRow.cloneNode(true);
          
          const newSelect = clonedRow.querySelector('.product-select');
          const newQtyInput = clonedRow.querySelector('.quantity-input');
          const removeBtn = clonedRow.querySelector('.remove-item-btn');
          
          newSelect.selectedIndex = 0;
          newQtyInput.value = 1;
          
          removeBtn.addEventListener('click', () => {
            clonedRow.remove();
            calculateCartTotals();
          });

          cartContainer.appendChild(clonedRow);
          calculateCartTotals();
        });

        cartContainer.querySelectorAll('.cart-item-row').forEach(row => {
          const removeBtn = row.querySelector('.remove-item-btn');
          removeBtn.addEventListener('click', () => {
            if (cartContainer.querySelectorAll('.cart-item-row').length > 1) {
              row.remove();
              calculateCartTotals();
            } else {
              alert("Your cart must contain at least one item to proceed.");
            }
          });
        });
                // ========== SUBMIT VALIDATION FOR EMPTY FIELDS ==========
        
        // Force disable browser native validation
        const depositForm = document.getElementById('depositForm');
        if (depositForm) {
          depositForm.setAttribute('novalidate', true);
          depositForm.noValidate = true;
        }
        
        function addRedBorder(field) {
            field.style.border = "1px solid #dc2626";
            field.style.backgroundColor = "#fff8f8";
        }
        
        function removeRedBorder(field) {
            field.style.border = "1px solid #ddd";
            field.style.backgroundColor = "";
        }
        
        function isEmpty(field) {
            if (field.tagName === 'SELECT') {
                return !field.value || field.value === '';
            }
            return field.value.trim() === '';
        }
        
        function showFieldError(field, message) {
            const existingError = field.parentElement.querySelector('.field-error');
            if (existingError) existingError.remove();
            
            const errorSpan = document.createElement('span');
            errorSpan.className = 'field-error';
            errorSpan.style.cssText = 'color: #dc2626; font-size: 12px; margin-top: 5px; display: block;';
            errorSpan.innerHTML = `<i class="fas fa-exclamation-circle" style="margin-right: 5px;"></i>${message}`;
            field.parentElement.appendChild(errorSpan);
        }
        
        function removeFieldError(field) {
            const error = field.parentElement.querySelector('.field-error');
            if (error) error.remove();
        }
        
        if (depositForm) {
            depositForm.addEventListener('submit', function(e) {
                let isValid = true;
                
                const customerSelect = document.querySelector('select[name="customerId"]');
                if (isEmpty(customerSelect)) {
                    isValid = false;
                    addRedBorder(customerSelect);
                    showFieldError(customerSelect, 'Please select a customer');
                } else {
                    removeRedBorder(customerSelect);
                    removeFieldError(customerSelect);
                }
                
                const depositAmount = document.querySelector('input[name="initialDeposit"]');
                if (isEmpty(depositAmount)) {
                    isValid = false;
                    addRedBorder(depositAmount);
                    showFieldError(depositAmount, 'Please enter deposit amount');
                } else {
                    removeRedBorder(depositAmount);
                    removeFieldError(depositAmount);
                }
                
                const cartRows = document.querySelectorAll('.cart-item-row');
                let hasValidItem = false;
                
                cartRows.forEach((row, index) => {
                    const productSelect = row.querySelector('.product-select');
                    const quantityInput = row.querySelector('.quantity-input');
                    let rowValid = true;
                    
                    if (isEmpty(productSelect)) {
                        isValid = false;
                        rowValid = false;
                        addRedBorder(productSelect);
                        showFieldError(productSelect, 'Please select a product');
                    } else {
                        removeRedBorder(productSelect);
                        removeFieldError(productSelect);
                        hasValidItem = true;
                    }
                    
                    if (isEmpty(quantityInput)) {
                        isValid = false;
                        rowValid = false;
                        addRedBorder(quantityInput);
                        showFieldError(quantityInput, 'Please enter quantity');
                    } else if (parseInt(quantityInput.value) < 1) {
                        isValid = false;
                        rowValid = false;
                        addRedBorder(quantityInput);
                        showFieldError(quantityInput, 'Quantity must be at least 1');
                    } else {
                        removeRedBorder(quantityInput);
                        removeFieldError(quantityInput);
                    }
                });
                
                if (!hasValidItem) {
                    isValid = false;
                }
                
                if (!isValid) {
                    e.preventDefault();
                    const firstError = document.querySelector('select, input');
                    if (firstError) {
                        firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                }
            });
        }
        
        const allFormFields = document.querySelectorAll('input, select');
        allFormFields.forEach(field => {
            field.addEventListener('input', function() {
                removeRedBorder(this);
                removeFieldError(this);
            });
            field.addEventListener('change', function() {
                removeRedBorder(this);
                removeFieldError(this);
            });
            field.addEventListener('focus', function() {
                removeRedBorder(this);
                removeFieldError(this);
            });
        });
        
        const observer = new MutationObserver(function() {
            const newFields = document.querySelectorAll('.cart-item-row input, .cart-item-row select');
            newFields.forEach(field => {
                if (!field.hasListener) {
                    field.hasListener = true;
                    field.addEventListener('input', function() {
                        removeRedBorder(this);
                        removeFieldError(this);
                    });
                    field.addEventListener('change', function() {
                        removeRedBorder(this);
                        removeFieldError(this);
                    });
                }
            });
        });
        
        observer.observe(document.getElementById('cartContainer'), { childList: true, subtree: true });
        
        // ========== END OF SUBMIT VALIDATION ==========
      });
      