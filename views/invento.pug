doctype html
html
  head
    meta(charset='UTF-8')
    title Inventory - Nyondo Hardware
    link(rel='stylesheet' href='/css/invento.css')
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css')

  body
    .sidebar
      .logo
        h2 ⚒ NYONDO HARDWARE
      ul
        li
          a(href='storedash')
            i.fas.fa-home.fa-fw
            span.nav-text Dashboard
        li.active
          a(href='invento')
            i.fas.fa-boxes.fa-fw
            span.nav-text Inventory
        li
          a(href='storereport')
            i.fas.fa-cash-register.fa-fw
            span.nav-text Reports
        li
          a(href='addstock')
            i.fas.fa-plus-circle.fa-fw
            span.nav-text Add Stock
        li
          a(href='logout')
            i.fas.fa-sign-out-alt.fa-fw
            span.nav-text Logout

    .main
      .header
        h1
          i.fas.fa-boxes
          |  Stock Overview
        .actions
          a.btn(href='addstock')
            i.fas.fa-plus
            |  Add Stock

      .cards
        .card
          i.fas.fa-cubes
          div
            h3 Total Items Added (Lifetime)
            p #{stats.totalProducts.toLocaleString()}
        .card.warn
          i.fas.fa-exclamation-triangle
          div
            h3 Low Stock
            p #{stats.lowStock.toLocaleString()}
        .card.success
          i.fas.fa-coins
          div
            h3 Total Value (Shelf)
            p #{stats.inventoryValue.toLocaleString()} UGX

      .search-bar
        input(type='text' placeholder='Search product...')

      .table-section
        table
          thead
            tr
              th #
              th Product Name
              th Image
              th Factory
              th Date Added
              th Status
              th Amount in Stock
              th Buying Price
              th Selling Price
              th Evidence
              th Actions
          tbody
            if dbStock.length === 0
              tr
                td(colspan='10') No stock records found.
            each stock, index in dbStock
              tr
                td #{index + 1}
                td #{stock.productName}
                td
                  if stock.itemImage
                    img(src='/' + stock.itemImage width='50' height='50')
                  else
                    span --
                td #{stock.factory}
                td #{new Date(stock.createdAt).toLocaleDateString()}
                //- Lifetime total added (grows with every edit)
                //- New column: Payment Status
                td
                  if stock.paymentStatus === 'Paid'
                    span.badge.badge-success Paid
                  else
                    span.badge.badge-warning Pending
                td #{stock.initialQuantity}
                //- Current shelf quantity (reduces with sales)
                td #{stock.buyingPrice.toLocaleString()}
                td #{stock.sellingPrice.toLocaleString()}
                td
                  a.btn-action.btn-evidence(href=`/evidence/${stock.supplierName}?batchId=${stock.paymentBatchId}` target="_blank")
                    i.fas.fa-file-alt
                    |  Voucher
                td
                  .action-btns
                    a.btn.btn-sm.btn-outline-warning(href=`/stock/edit/${stock._id}`)
                      span.action-label EDIT
                      i.fas.fa-edit
                    form(action=`/deleted/${stock._id}` method='post' onsubmit='return confirm("Delete this record?")')
                      button.btn.btn-sm.btn-outline-danger(type='submit')
                        span.action-label DELETE
                        i.fas.fa-trash-alt