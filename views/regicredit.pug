doctype html
html(lang="en")
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Credit Customer Registration - Nyondo

    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css')
    link(rel='stylesheet' href='/css/regicredit.css')

    style.
      .error-message {
        background-color: #fce4e4;
        border: 1px solid #fcc2c2;
        color: #cc0033;
        padding: 12px;
        margin-bottom: 20px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: bold;
      }
      .hidden {
        display: none !important;
      }
      .inline-error {
        color: #cc0033;
        font-size: 0.75rem;
        margin-top: 4px;
        display: block;
      }

  body
    .sidebar
      .logo
        span ⚒ NYONDO HARDWARE
      ul
        li: a(href='admindash') #[i.fas.fa-home] Dashboard
        li: a(href='regicredit') #[i.fas.fa-cash-register] Customers
        li: a(href='deposit') #[i.fas.fa-boxes] Deposits
        li: a.active(href='suppliers') #[i.fas.fa-user-plus] Suppliers
        li: a(href='/logout') #[i.fas.fa-right-from-bracket] Logout

    .main-content
      .container
        .register-box
          .top
            p Secure Customer Enrollment

          if error
            #errorBox.error-message
              i.fas.fa-circle-exclamation
              span #{error}

          form(action='/regicredit' method='post')
            .grid-container
              .input-group
                label Full Names
                .input-field
                  i.fas.fa-user
                  input#fullName(type='text' name='fullName' placeholder='Enter full name' required)
                span#fullNameError.inline-error.hidden Name is too short.

              .input-group
                label NIN (14 Characters)
                .input-field
                  i.fas.fa-id-card
                  input#nin(
                    type='text' 
                    name='nin' 
                    placeholder='CM0123456789AB' 
                    required 
                    minlength='14' 
                    maxlength='14' 
                    pattern='^(CM|CF)[0-9]{2}[A-Z0-9]{10}$'
                    title='Must start with CM or CF, followed by 2 digits and 10 alphanumeric characters.'
                  )
                span#ninError.inline-error.hidden Format: CM/CF + 2 digits + 10 chars.
              .input-group
                label Phone (+256...)
                .input-field
                  i.fas.fa-phone
                  input#phoneNumber(type='text' name='phoneNumber' placeholder='+2567...' required)
                span#phoneError.inline-error.hidden Format: +256... or 07...

              .input-group
                label Address
                .input-field
                  i.fas.fa-location-dot
                  input#address(type='text' name='address' placeholder='e.g. Nansana, Kampala' required)
                span#addressError.inline-error.hidden Address is required.

              .input-group
                label Distance (KM)
                .input-field
                  i.fas.fa-truck-fast
                  input#distance(type='number' name='distanceFromStore' placeholder='0' required min='1')
                span#distanceError.inline-error.hidden Distance must be at least 1 KM.
              .input-group
                label(style="display: flex; align-items: center; gap: 8px;")
                  input(type='checkbox' name='hasOwnTransport' id='hasOwnTransport' style="width: auto; height: auto;")
                  | Customer has own transport
              .input-group
                label Email (Username)
                .input-field
                  i.fas.fa-envelope
                  input#email(type='email' name='email' placeholder='customer@gmail.com' required)
                span#emailError.inline-error.hidden Enter a valid email.

              .input-group
                label Create Password
                .input-field
                  i.fas.fa-lock
                  input#password(type='password' name='password' placeholder='Between 6 and 14 characters' required)
                  i#togglePassword.fas.fa-eye.toggle-eye
                span#passwordError.inline-error.hidden Password must be 6-14 characters.

            button.btn(type='submit')
              i.fas.fa-user-check
              span Register Customer

      section.customer-table
        .table-header: h2 Registered Credit Customers
        table
          thead
            tr
              th #
              th Full Name
              th NIN
              th Phone
              th Address
              th Distance
              th Email
              th Actions
          tbody
            if customers && customers.length > 0
              each customer, index  in customers
                tr
                  td #{index + 1}
                  td #{customer.fullName}
                  td #{customer.nin}
                  td #{customer.phoneNumber}
                  td #{customer.address}
                  td #{customer.distanceFromStore} KM
                  td #{customer.email}
                  td
                    .action-buttons
                      a.edit-btn(href=`/credit/edit/${customer._id}`) #[i.fas.fa-pen]
                      form(action=`/credit/delete/${customer._id}` method='post' onsubmit='return confirm("Delete this customer?")')
                        button.delete-btn(type='submit') #[i.fas.fa-trash]
            else
              tr: td.empty(colspan='7') No registered credit customers yet

    script.
      // PASSWORD TOGGLE
      const togglePassword = document.querySelector('#togglePassword');
      const passwordField = document.querySelector('#password');
      togglePassword.addEventListener('click', function () {
        const isPassword = passwordField.getAttribute('type') === 'password';
        passwordField.setAttribute('type', isPassword ? 'text' : 'password');
        this.classList.toggle('fa-eye');
        this.classList.toggle('fa-eye-slash');
      });

      // HIDE SERVER ERROR
      const errorBox = document.getElementById('errorBox');
      if (errorBox) {
        document.querySelectorAll('input').forEach(input => {
          input.addEventListener('input', () => errorBox.classList.add('hidden'), { once: true });
        });
      }

      // REAL-TIME VALIDATION
      const rules = {
        nin: { regex: /^(CM|CF)[0-9]{2}[A-Z0-9]{10}$/, error: 'ninError' },
        phoneNumber: { regex: /^(07\d{8}|\+256\d{9})$/, error: 'phoneError' },
        email: { regex: /^[^\s@]+@[^\s@]+\.[^\s@]+$/, error: 'emailError' },
        password: { regex: /^.{6,14}$/, error: 'passwordError' },
        fullName: { regex: /.{3,}/, error: 'fullNameError' },
        address: { regex: /.{3,}/, error: 'addressError' },
        distance: { regex: /^[1-9]\d*$/, error: 'distanceError' }
      };

      Object.keys(rules).forEach(id => {
        const input = document.getElementById(id);
        const errorSpan = document.getElementById(rules[id].error);
        if(!input || !errorSpan) return;

        input.addEventListener('input', () => {
          if(id === 'nin') input.value = input.value.toUpperCase();
          
          if (input.value.length > 0 && !rules[id].regex.test(input.value)) {
            errorSpan.classList.remove('hidden');
            input.style.border = "1px solid red";
          } else {
            errorSpan.classList.add('hidden');
            input.style.border = "1px solid #ccc";
          }
        });

        
      });
      
      // Force disable browser native validation
      const form = document.querySelector('form');
      if (form) {
        form.setAttribute('novalidate', true);
        form.noValidate = true;
      }
      
      // Function to add red border
      function addErrorStyle(field) {
          field.style.border = "1px solid #dc2626";
          field.style.backgroundColor = "#fff8f8";
      }
      
      // Function to remove red border
      function removeErrorStyle(field) {
          field.style.border = "1px solid #ccc";
          field.style.backgroundColor = "";
      }
      
      // Function to check if a field is empty
      function isFieldEmpty(field) {
          if (field.type === 'checkbox') {
              return false;
          }
          const value = field.value.trim();
          return value === '';
      }
      
      // Function to show error message for empty field
      function showEmptyError(field) {
          const fieldId = field.id;
          let errorSpanId = null;
          
          if (fieldId === 'fullName') errorSpanId = 'fullNameError';
          else if (fieldId === 'nin') errorSpanId = 'ninError';
          else if (fieldId === 'phoneNumber') errorSpanId = 'phoneError';
          else if (fieldId === 'address') errorSpanId = 'addressError';
          else if (fieldId === 'distance') errorSpanId = 'distanceError';
          else if (fieldId === 'email') errorSpanId = 'emailError';
          else if (fieldId === 'password') errorSpanId = 'passwordError';
          
          if (errorSpanId) {
              const errorSpan = document.getElementById(errorSpanId);
              if (errorSpan) {
                  if (fieldId === 'fullName') errorSpan.textContent = 'Full name is required';
                  else if (fieldId === 'nin') errorSpan.textContent = 'NIN is required';
                  else if (fieldId === 'phoneNumber') errorSpan.textContent = 'Phone number is required';
                  else if (fieldId === 'address') errorSpan.textContent = 'Address is required';
                  else if (fieldId === 'distance') errorSpan.textContent = 'Distance is required';
                  else if (fieldId === 'email') errorSpan.textContent = 'Email is required';
                  else if (fieldId === 'password') errorSpan.textContent = 'Password is required';
                  
                  errorSpan.classList.remove('hidden');
              }
          }
      }
      
      // Function to restore original error message
      function restoreOriginalErrorMessage(field) {
          const fieldId = field.id;
          let errorSpanId = null;
          let originalMessage = '';
          
          if (fieldId === 'fullName') {
              errorSpanId = 'fullNameError';
              originalMessage = 'Name is too short.';
          }
          else if (fieldId === 'nin') {
              errorSpanId = 'ninError';
              originalMessage = 'Format: CM/CF + 2 digits + 10 chars.';
          }
          else if (fieldId === 'phoneNumber') {
              errorSpanId = 'phoneError';
              originalMessage = 'Format: +256... or 07...';
          }
          else if (fieldId === 'address') {
              errorSpanId = 'addressError';
              originalMessage = 'Address is required.';
          }
          else if (fieldId === 'distance') {
              errorSpanId = 'distanceError';
              originalMessage = 'Distance must be at least 1 KM.';
          }
          else if (fieldId === 'email') {
              errorSpanId = 'emailError';
              originalMessage = 'Enter a valid email.';
          }
          else if (fieldId === 'password') {
              errorSpanId = 'passwordError';
              originalMessage = 'Password must be 6-14 characters.';
          }
          
          if (errorSpanId) {
              const errorSpan = document.getElementById(errorSpanId);
              if (errorSpan && errorSpan.textContent !== originalMessage) {
                  errorSpan.textContent = originalMessage;
              }
          }
      }
      
      // Validate all fields on submit
      if (form) {
          form.addEventListener('submit', function(e) {
              let isValid = true;
              const allFields = document.querySelectorAll('input:not([type="checkbox"])');
              
              allFields.forEach(field => {
                  if (isFieldEmpty(field)) {
                      isValid = false;
                      addErrorStyle(field);
                      showEmptyError(field);
                  } else {
                      const fieldId = field.id;
                      const rule = rules[fieldId];
                      if (rule && !rule.regex.test(field.value)) {
                          isValid = false;
                          addErrorStyle(field);
                      } else {
                          removeErrorStyle(field);
                          restoreOriginalErrorMessage(field);
                      }
                  }
              });
              
              if (!isValid) {
                  e.preventDefault();
                  const firstError = document.querySelector('input[style*="border: 1px solid rgb(220, 38, 38)"]');
                  if (firstError) {
                      firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                  }
              }
          });
      }
      
      // Remove red border when user starts typing
      const allInputs = document.querySelectorAll('input:not([type="checkbox"])');
      allInputs.forEach(input => {
          input.addEventListener('input', function() {
              this.style.border = "1px solid #ccc";
              this.style.backgroundColor = "";
              restoreOriginalErrorMessage(this);
              
              const fieldId = this.id;
              const rule = rules[fieldId];
              if (rule && this.value.length > 0 && !rule.regex.test(this.value)) {
                  const errorSpan = document.getElementById(rule.error);
                  if (errorSpan) errorSpan.classList.remove('hidden');
                  this.style.border = "1px solid red";
              } else if (rule && this.value.length > 0 && rule.regex.test(this.value)) {
                  const errorSpan = document.getElementById(rule.error);
                  if (errorSpan) errorSpan.classList.add('hidden');
              }
          });
      });
    