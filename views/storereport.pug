doctype html
html
  head
    title Stock Management Report
    //- Link to your external CSS file
    link(rel="stylesheet", href="/css/store.css")
    //- Ensure Font Awesome is linked in your main layout or here
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
  body
    .no-print
      a(href="/storedash") 
        i.fas.fa-arrow-left 
        |  Back to Dashboard
    
    .report-header
      h1 
        i.fas.fa-chart-line 
        |  Comprehensive Stock Report
      p Generated on: #{reportDate}

    //- 1. KPI Summary Section
    .grid
      .card 
        h4 
          i.fas.fa-boxes 
          |  Total Inventory Value
        p UGX #{stats.totalInventoryValue.toLocaleString()}
      .card 
        h4 
          i.fas.fa-file-invoice-dollar 
          |  Total Stock Pending Debt
        p UGX #{stats.pendingDebt.toLocaleString()}
      .card 
        h4 
          i.fas.fa-percentage 
          |  Potential Profit
        p UGX #{stats.potentialProfit.toLocaleString()}
      .card 
        h4 
          i.fas.fa-exclamation-triangle 
          |  Items At Risk
        p #{lowStockItems.length} Products

    //- 2. Critical Alerts
    h2 
      i.fas.fa-bell 
      |  Critical Low Stock
    table
      thead
        tr
          th Product Name
          th Current Quantity
          th Supplier
      tbody
        each item in lowStockItems
          tr
            td= item.productName
            td(class='status-low') #{item.quantity}
            td= item.supplierName

    //- 3. Full Detailed Inventory
    h2 
      i.fas.fa-list-ul 
      |  Full Inventory Details
    table
      thead
        tr
          th Product
          th Category
          th Quantity
          th Buy Price
          th Total Value
      tbody
        each item in inventory
          tr
            td= item.productName
            td= item.category
            td= item.quantity
            td= item.buyingPrice.toLocaleString()
            td= (item.quantity * item.buyingPrice).toLocaleString()
    
    .no-print
      button(onclick="window.print()") 
        i.fas.fa-print 
        |  Print Report