doctype html
html
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Nyondo Hardware Receipt

    link(rel='stylesheet' href='/css/receipt.css')
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css')

  body
    .receipt-container
      .receipt-card
        .receipt-header
          h2 NYONDO GENERAL HARDWARE
          p.address Nansana, Wakiso District - Katooke Road
          p.contact Tel: 0721-234567 | 0772-987654

          .meta-info
            small
              i.fas.fa-calendar-alt
              |   Date: #{new Date(sale.date).toLocaleString()}
            br
            small
              i.fas.fa-receipt
              |   Receipt #: #{sale._id.toString().slice(-6).toUpperCase()}

        hr.divider
        .items-section
          table.items-table
            thead
              tr
                th Description
                th Qty
                th.right Amount

            tbody
              if sale.items && sale.items.length > 0
                each item in sale.items
                  tr
                    td
                      span.item-name
                        i.fas.fa-box
                        |   #{item.productName ? item.productName.productName : 'Item Deleted'}

                    td.center #{item.quantity}

                    td.right #{item.total ? item.total.toLocaleString() : '0'} UGX

              else
                tr
                  td.center(colspan="3")
                    | No items listed on this transaction.

        hr.divider
        .logistics

          .row
            span.label Delivery Option:
            span.value.delivery-highlight #{sale.deliveryOption || 'pickup'}

          if sale.deliveryOption === 'delivery'
            .row
              span.label Distance:
              span.value #{sale.distance || 0} km

          .row
            span.label Transport Charge:
            span.value
              | #{sale.transportFee !== undefined && sale.transportFee !== null ? sale.transportFee.toLocaleString() : '0'} UGX

        hr.divider
        .totals

          .row
            span.label Total Cost (Products):
            span.value #{sale.totalAmount ? sale.totalAmount.toLocaleString() : '0'} UGX

        hr.divider

        .grand-total
          .row
            span.label Total Charge:
            span.value.total-price
              | #{sale.totalAmount ? (sale.totalAmount + (sale.transportFee || 0)).toLocaleString() : '0'} UGX

        hr.divider.bold
        .footer
          p
            i.fas.fa-user
            |   Served by: #{sale.attendant ? sale.attendant.fullname : 'System Operator'}

          p.thanks
            i.fas.fa-heart
            |   Thanks For Shopping With Us

          p.disclaimer Goods once sold are not returnable
          p.transport-note
            | Transport charges are calculated based on delivery distance and are added to the total product cost to form the final payable amount.

    .actions.d-print-none
      button.print-btn(onclick='window.print()')
        i.fas.fa-print
        |   Print Receipt

      a.back-btn(href='/newsale')
        i.fas.fa-arrow-left
        |   View Sales