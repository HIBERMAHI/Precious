doctype html
html
  head
    meta(charset='UTF-8')
    title Nyondo Sales
    link(rel='stylesheet' href='/css/newsale.css')
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css')

  body
    .sidebar
      .logo
        | ⚒ NYONDO HARDWARE
      ul
        li
          a(href='ssales')
            i.fas.fa-home
            |   Dashboard
        li
          a(href='newsale').active
            i.fas.fa-cash-register
            |   New Sale
        li
          a(href='stockview')
            i.fas.fa-box
            |   Stock View
        li
          a(href='logout')
            i.fas.fa-sign-out-alt
            |   Logout

    .main
      h1 Sales Management

      section.sale-form-card
        h2.form-title Register New Sale

        // Global Alert Message Block
        if error
          p#error-msg(style="color: white; background-color: #d9534f; padding: 12px; border-radius: 5px; margin-bottom: 20px; font-weight: bold; text-align: center; border: 1px solid #b94a48;") #{error}

        form(action='/newsale' method='post')
          
          // Customer Details Layer
          .form-grid
            .form-group
              label Customer Name
              input.form-input(
                type='text' 
                name='customerName' 
                placeholder='Enter client name'
                required
              )

            .form-group
              label Phone Number
              input.form-input(
                type='text' 
                name='phone' 
                placeholder='07... / +256...'
                required
              )

            .form-group
              label Delivery Option
              select.form-input(name='deliveryOption' required)
                option(value='' disabled selected)
                option(value='pickup') Pickup
                option(value='delivery') Delivery

            .form-group
              label Distance (km)
              input.form-input(
                type='number' 
                name='distance' 
                placeholder='0'
                min='0'
                step='0.1'
              )

          hr(style="border: 0; border-top: 1px solid #e2e8f0; margin: 20px 0;")

          // Multi-Item Section Injection Layer
          .items-section
            .items-header
              h3 Sale Items
              button.add-item-btn(type='button' onclick='addItemRow()')
                i.fas.fa-plus
                |   Add Item Row

            .items-container#items-container
              .item-row
                .form-group
                  label Product Name
                  select.form-input(name='productName' required)
                    option(value='' disabled selected) Select product
                    if items && items.length > 0
                      each product in items
                        option(value=product._id) #{product.productName} (Qty: #{product.quantity} | #{product.sellingPrice} UGX)

                .form-group
                  label Quantity
                  input.form-input(type='number' name='quantity' required min='1')

                input(type='hidden' name='price')

                button.remove-btn(type='button' onclick='removeItemRow(this)')
                  span.btn-text Delete
                  i.fas.fa-trash-alt

          hr(style="border: 0; border-top: 1px solid #e2e8f0; margin: 20px 0;")

          // Sale Status Conditions
          .form-grid
            .form-group
              label Payment Method
              select.form-input(name='paymentMethod' required)
                option(value='' disabled selected ) select Payment method
                option(value='cash') Cash
                option(value='mobile') Mobile Money
                option(value='bank') Bank

            .form-group
              label Status
              select.form-input(name='status' required)
                option(value='' disabled selected) 
                option(value='completed') Completed

          .button-group
            button.register-btn(type='submit')
              i.fas.fa-plus
              |   Register Sale
      section.recent-sales-card
        h2.sales-title Recent Sales
        table
          thead
            tr
              th #
              th Client
              th Items Summary
              th Qty
              th P.Method
              th T.Fee
              th Distance(KM)
              th Attendant
              th Date
              if user && (user.role === "salesattendant" || user.role === "admin")
                th Actions
          tbody
            if dbSales && dbSales.length > 0
              each sale , index in dbSales
                tr
                  td #{index + 1}
                  td #{sale.customerName}
                  
                  td(style="text-align: left; padding-left: 10px;")
                    if sale.items && sale.items.length > 0
                      ul(style="list-style: none; padding: 0; margin: 0; font-size: 12px;")
                        each subItem in sale.items
                          li(style="font-weight: 600; text-transform: uppercase; color: #1e293b; margin-bottom: 4px;")
                            | #{subItem.productName ? subItem.productName.productName : 'Item deleted'}
                    else
                      span(style="color: #94a3b8;") No items specified
                  
                  td(style="text-align: center;")
                    if sale.items && sale.items.length > 0
                      ul(style="list-style: none; padding: 0; margin: 0; font-size: 12px;")
                        each subItem in sale.items
                          li(style="font-weight: 600; color: #475569; margin-bottom: 4px;")
                            | #{subItem.quantity}
                    else
                      span(style="color: #94a3b8;") -

                  td #{sale.paymentMethod}
                  
                  td #{sale.transportFee ? sale.transportFee.toLocaleString() : '0'}
                  td(style="font-weight: 700;") #{sale.distance ? sale.distance.toLocaleString() : '0'}
                  td #{sale.attendant ? sale.attendant.fullname : 'unknown'}
                  td #{new Date(sale.date).toLocaleString()}
                  
                  if user && (user.role === "salesattendant" || user.role === "admin")
                    td
                      .actions-cell
                        a.action-btn.receipt-btn(href=`/receipt/${sale._id}` title="View Receipt")
                          span.action-label Receipt
                          i.fas.fa-file-invoice
                        
                        a.action-btn.edit-btn(href=`/sale/edit/${sale._id}` title="Edit Sale")
                          //- span.action-label EDIT
                          i.fas.fa-edit
                        
                        form(action=`/delete/${sale._id}` method='post' onsubmit='return confirm("Are you sure you want to delete this sale?")' style='display:inline;')
                          button.action-btn.delete-btn(type='submit' style="background: none; border: none; cursor: pointer;")
                            //- span.action-label DELETE
                            i.fas.fa-trash-alt
            else
              tr
                td(colspan=(user && (user.role === "salesattendant" || user.role === "admin") ? '10' : '9')) No sales have been recorded yet

    script.
      const availableStocks = !{JSON.stringify(items || [])};

      function updateRowPrice(rowElement) {
        const productSelect = rowElement.querySelector('select[name="productName"]');
        const quantityInput = rowElement.querySelector('input[name="quantity"]');
        const priceInput = rowElement.querySelector('input[name="price"]');
        const selectedProductId = productSelect.value;
        const quantity = parseInt(quantityInput.value) || 1;
        const matchedProduct = availableStocks.find(product => product._id === selectedProductId);
        if (matchedProduct) {
          const totalPrice = matchedProduct.sellingPrice * quantity;
          priceInput.value = totalPrice;
        } else {
          priceInput.value = '';
        }
      }

      document.getElementById('items-container').addEventListener('input', (event) => {
        const target = event.target;
        if (target.name === 'productName' || target.name === 'quantity') {
          const row = target.closest('.item-row');
          updateRowPrice(row);
        }
      });

      function addItemRow() {
        const container = document.getElementById('items-container');
        let optionsHTML = '<option value="" disabled selected>Select product</option>';
        availableStocks.forEach(product => {
          optionsHTML += `<option value="${product._id}">${product.productName} (Qty: ${product.quantity} | ${product.sellingPrice} UGX)</option>`;
        });

        const newRow = document.createElement('div');
        newRow.className = 'item-row';
        newRow.innerHTML = `
          <div class="form-group">
            <label>Product Name</label>
            <select class="form-input" name="productName" required>
              ${optionsHTML}
            </select>
          </div>
          <div class="form-group">
            <label>Quantity</label>
            <input class="form-input" type="number" name="quantity" required min="1">
          </div>
          <input type="hidden" name="price">
          <button class="remove-btn" type="button" onclick="removeItemRow(this)">
            <i class="fas fa-trash-alt"></i>
          </button>
        `;
        container.appendChild(newRow);
      }

      function removeItemRow(buttonElement) {
        const rows = document.querySelectorAll('.item-row');
        if (rows.length > 1) {
          buttonElement.closest('.item-row').remove();
        } else {
          alert("A sale transaction must contain at least one row item entry.");
        }
      }

      document.addEventListener('DOMContentLoaded', () => {
        const errorMsg = document.getElementById('error-msg');
        if (errorMsg) {
          const clearError = () => { errorMsg.style.display = 'none'; };
          document.addEventListener('input', clearError, { once: true });
          document.addEventListener('change', clearError, { once: true });
        }

                // SUBMIT VALIDATION FOR ALL FIELDS
        
        // Force disable browser native validation
        const saleForm = document.querySelector('form');
        if (saleForm) {
          saleForm.setAttribute('novalidate', true);
          saleForm.noValidate = true;
        }
        
        function addRedBorder(field) {
            field.style.border = "1px solid #dc2626";
            field.style.backgroundColor = "#fff8f8";
        }
        
        function removeRedBorder(field) {
            field.style.border = "1px solid #ddd";
            field.style.backgroundColor = "";
        }
        
        function isEmpty(field) {
            if (field.tagName === 'SELECT') {
                return !field.value || field.value === '';
            }
            return field.value.trim() === '';
        }
        
        function showFieldError(field, message) {
            const existingError = field.parentElement.querySelector('.field-error');
            if (existingError) existingError.remove();
            
            const errorSpan = document.createElement('span');
            errorSpan.className = 'field-error';
            errorSpan.style.cssText = 'color: #dc2626; font-size: 12px; margin-top: 5px; display: block;';
            errorSpan.innerHTML = `<i class="fas fa-exclamation-circle" style="margin-right: 5px;"></i>${message}`;
            field.parentElement.appendChild(errorSpan);
        }
        
        function removeFieldError(field) {
            const error = field.parentElement.querySelector('.field-error');
            if (error) error.remove();
        }
        
        if (saleForm) {
            saleForm.addEventListener('submit', function(e) {
                let isValid = true;
                
                // Check customer name
                const customerName = document.querySelector('input[name="customerName"]');
                if (isEmpty(customerName)) {
                    isValid = false;
                    addRedBorder(customerName);
                    showFieldError(customerName, 'Please enter customer name');
                } else {
                    removeRedBorder(customerName);
                    removeFieldError(customerName);
                }
                
                // Check phone number
                const phone = document.querySelector('input[name="phone"]');
                if (isEmpty(phone)) {
                    isValid = false;
                    addRedBorder(phone);
                    showFieldError(phone, 'Please enter phone number');
                } else {
                    removeRedBorder(phone);
                    removeFieldError(phone);
                }
                
                // Check delivery option
                const deliveryOption = document.querySelector('select[name="deliveryOption"]');
                if (isEmpty(deliveryOption)) {
                    isValid = false;
                    addRedBorder(deliveryOption);
                    showFieldError(deliveryOption, 'Please select delivery option');
                } else {
                    removeRedBorder(deliveryOption);
                    removeFieldError(deliveryOption);
                }
                
                                // Check distance (required ONLY for delivery)
                const distance = document.querySelector('input[name="distance"]');
                if (deliveryOption && deliveryOption.value === 'delivery') {
                    // Delivery selected - distance is REQUIRED
                    if (isEmpty(distance)) {
                        isValid = false;
                        addRedBorder(distance);
                        showFieldError(distance, 'Please enter distance for delivery');
                    } else if (parseFloat(distance.value) <= 0) {
                        isValid = false;
                        addRedBorder(distance);
                        showFieldError(distance, 'Distance must be greater than 0 for delivery');
                    } else {
                        removeRedBorder(distance);
                        removeFieldError(distance);
                    }
                } else {
                    // Pickup selected - distance is OPTIONAL
                    // Only validate if user entered something invalid (negative)
                    if (!isEmpty(distance) && parseFloat(distance.value) < 0) {
                        isValid = false;
                        addRedBorder(distance);
                        showFieldError(distance, 'Distance cannot be negative');
                    } else {
                        // No red border for empty distance when pickup is selected
                        removeRedBorder(distance);
                        removeFieldError(distance);
                    }
                }
                
                // Check payment method
                const paymentMethod = document.querySelector('select[name="paymentMethod"]');
                if (isEmpty(paymentMethod)) {
                    isValid = false;
                    addRedBorder(paymentMethod);
                    showFieldError(paymentMethod, 'Please select payment method');
                } else {
                    removeRedBorder(paymentMethod);
                    removeFieldError(paymentMethod);
                }
                
                // Check status
                const status = document.querySelector('select[name="status"]');
                if (isEmpty(status)) {
                    isValid = false;
                    addRedBorder(status);
                    showFieldError(status, 'Please select status');
                } else {
                    removeRedBorder(status);
                    removeFieldError(status);
                }
                
                // Check all cart items (products and quantities)
                const cartRows = document.querySelectorAll('.item-row');
                let hasValidItem = false;
                
                cartRows.forEach((row, index) => {
                    const productSelect = row.querySelector('select[name="productName"]');
                    const quantityInput = row.querySelector('input[name="quantity"]');
                    let rowValid = true;
                    
                    if (isEmpty(productSelect)) {
                        isValid = false;
                        rowValid = false;
                        addRedBorder(productSelect);
                        showFieldError(productSelect, 'Please select a product');
                    } else {
                        removeRedBorder(productSelect);
                        removeFieldError(productSelect);
                        hasValidItem = true;
                    }
                    
                    if (isEmpty(quantityInput)) {
                        isValid = false;
                        rowValid = false;
                        addRedBorder(quantityInput);
                        showFieldError(quantityInput, 'Please enter quantity');
                    } else if (parseInt(quantityInput.value) < 1) {
                        isValid = false;
                        rowValid = false;
                        addRedBorder(quantityInput);
                        showFieldError(quantityInput, 'Quantity must be at least 1');
                    } else {
                        removeRedBorder(quantityInput);
                        removeFieldError(quantityInput);
                    }
                });
                
                if (!hasValidItem) {
                    isValid = false;
                }
                
                if (!isValid) {
                    e.preventDefault();
                    const firstError = document.querySelector('input, select');
                    if (firstError) {
                        firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                }
            });
        }
        
        // Remove red border and error when user starts typing
        const allFormFields = document.querySelectorAll('input, select');
        allFormFields.forEach(field => {
            field.addEventListener('input', function() {
                removeRedBorder(this);
                removeFieldError(this);
            });
            field.addEventListener('change', function() {
                removeRedBorder(this);
                removeFieldError(this);
            });
            field.addEventListener('focus', function() {
                removeRedBorder(this);
                removeFieldError(this);
            });
        });
        
        // Also add to dynamically added items
        const observer = new MutationObserver(function() {
            const newFields = document.querySelectorAll('.item-row input, .item-row select');
            newFields.forEach(field => {
                if (!field.hasListener) {
                    field.hasListener = true;
                    field.addEventListener('input', function() {
                        removeRedBorder(this);
                        removeFieldError(this);
                    });
                    field.addEventListener('change', function() {
                        removeRedBorder(this);
                        removeFieldError(this);
                    });
                }
            });
        });
        
        const itemsContainer = document.getElementById('items-container');
        if (itemsContainer) {
            observer.observe(itemsContainer, { childList: true, subtree: true });
        }
        
        // END OF SUBMIT VALIDATION 
      });