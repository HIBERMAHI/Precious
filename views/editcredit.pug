doctype html
html(lang="en")
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title Update Customer - Nyondo Hardware
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css')
    link(rel='stylesheet' href='/css/regicredit.css')
    style.
      .error-message {
        background-color: #fce4e4;
        border: 1px solid #fcc2c2;
        color: #cc0033;
        padding: 12px;
        margin-bottom: 20px;
        border-radius: 6px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: bold;
      }
      .success-color { background-color: #e6fffa; border: 1px solid #00875a; color: #00875a; }
      .hidden { display: none !important; }
      .toggle-eye { cursor: pointer; margin-left: -30px; z-index: 10; }

  body
    .sidebar
      .logo: span ⚒ NYONDO HARDWARE
      ul
        li: a(href='/admindash') 
          i.fas.fa-home 
          span Dashboard
        li: a(href='/regicredit').active 
          i.fas.fa-user-edit 
          span Edit Customer
    .main-content
      .container
        .register-box
          .top
            p Update Customer Profile: #{customer.fullName}
          
          //- Error Box: Displays message from server or validation
          if error
            #errorBox.error-message
              i#errorIcon.fas.fa-circle-exclamation
              span#errorMessage #{error}
          else
            #errorBox.error-message.hidden
              i#errorIcon.fas.fa-circle-exclamation
              span#errorMessage

          form#editForm(action=`/credit/update/${customer._id}` method='post')
            .grid-container
              .input-group
                label Full Names
                .input-field
                  i.fas.fa-user
                  input(type='text' name='fullName' value=customer.fullName required)

              .input-group
                label Phone Number
                .input-field
                  i.fas.fa-phone
                  input#phoneNumber(type='text' name='phoneNumber' value=customer.phoneNumber required placeholder='07XXXXXXXX')

              .input-group
                label Address
                .input-field
                  i.fas.fa-location-dot
                  input(type='text' name='address' value=customer.address required)

              .input-group
                label Distance (KM)
                .input-field
                  i.fas.fa-truck-fast
                  input(type='number' name='distanceFromStore' value=customer.distanceFromStore required min='1')
                  
              .input-group
                label Transport Preference
                .input-field(style="display: flex; align-items: center; gap: 10px; border: none; padding: 0;")
                  input(type='checkbox' name='hasOwnTransport' id='hasOwnTransport' checked=customer.hasOwnTransport style="width: 18px; height: 18px; cursor: pointer; margin: 0;")
                  label(for='hasOwnTransport' style="margin: 0; font-weight: normal;") Customer uses their own transport

              .input-group
                label Email (Locked)
                .input-field
                  i.fas.fa-envelope
                  input(type='email' value=customer.email disabled)
              
              .input-group
                label NIN (Locked)
                .input-field
                  i.fas.fa-id-card
                  input#nin(type='text' name='nin' value=customer.nin readonly)

              .input-group.full-width
                label Confirm Password to Save Changes
                .input-field
                  i.fas.fa-lock
                  input#password(type='password' name='password' placeholder='Enter password to verify' required)
                  i#togglePassword.fas.fa-eye.toggle-eye

            button.btn(type='submit')
              i.fas.fa-save
              span Update Information
    script.
      document.addEventListener('DOMContentLoaded', () => {
        const errorBox = document.getElementById('errorBox');
        const errorMessage = document.getElementById('errorMessage');
        const errorIcon = document.getElementById('errorIcon');
        const editForm = document.getElementById('editForm');
        const phoneInput = document.getElementById('phoneNumber');
        const passwordField = document.getElementById('password');
        const togglePassword = document.getElementById('togglePassword');
        const fullNameInput = document.querySelector('input[name="fullName"]');
        const addressInput = document.querySelector('input[name="address"]');
        const distanceInput = document.querySelector('input[name="distanceFromStore"]');

        // Force disable browser native validation
        editForm.setAttribute('novalidate', true);
        editForm.noValidate = true;

        function addRedBorder(field) {
            field.style.border = "1px solid #dc2626";
            field.style.backgroundColor = "#fff8f8";
        }

        function removeRedBorder(field) {
            field.style.border = "1px solid #ccc";
            field.style.backgroundColor = "";
        }

               function showFieldError(field, message) {
            // Remove existing error
            let errorSpan = field.closest('.input-group').querySelector('.field-error');
            if (errorSpan) errorSpan.remove();
            
            // Create new error message
            errorSpan = document.createElement('span');
            errorSpan.className = 'field-error';
            errorSpan.style.cssText = 'color: #dc2626; font-size: 12px; margin-top: 5px; display: block;';
            errorSpan.innerHTML = `<i class="fas fa-exclamation-circle" style="margin-right: 5px;"></i>${message}`;
            
            // Add error message to the input-group (outside the input-field)
            const inputGroup = field.closest('.input-group');
            inputGroup.appendChild(errorSpan);
        }

        function removeFieldError(field) {
            const errorSpan = field.closest('.input-group').querySelector('.field-error');
            if (errorSpan) errorSpan.remove();
        }

        function isEmpty(field) {
            return field.value.trim() === '';
        }

        function validateField(field, fieldName) {
            if (isEmpty(field)) {
                addRedBorder(field);
                showFieldError(field, `${fieldName} is required`);
                return false;
            } else {
                removeRedBorder(field);
                removeFieldError(field);
                return true;
            }
        }

        function validatePhone() {
            const phoneRegex = /^(?:07\d{8}|\+256\d{9})$/;
            if (isEmpty(phoneInput)) {
                addRedBorder(phoneInput);
                showFieldError(phoneInput, 'Phone number is required');
                return false;
            } else if (!phoneRegex.test(phoneInput.value)) {
                addRedBorder(phoneInput);
                showFieldError(phoneInput, 'Phone must start with 07 or +256 (e.g., 07XXXXXXXX or +256XXXXXXXXX)');
                return false;
            } else {
                removeRedBorder(phoneInput);
                removeFieldError(phoneInput);
                return true;
            }
        }

        function validatePassword() {
            if (isEmpty(passwordField)) {
                addRedBorder(passwordField);
                showFieldError(passwordField, 'Password is required');
                return false;
            } else if (passwordField.value.length < 6 || passwordField.value.length > 14) {
                addRedBorder(passwordField);
                showFieldError(passwordField, 'Password must be 6-14 characters');
                return false;
            } else {
                removeRedBorder(passwordField);
                removeFieldError(passwordField);
                return true;
            }
        }

        function validateDistance() {
            if (isEmpty(distanceInput)) {
                addRedBorder(distanceInput);
                showFieldError(distanceInput, 'Distance is required');
                return false;
            } else if (parseInt(distanceInput.value) < 1) {
                addRedBorder(distanceInput);
                showFieldError(distanceInput, 'Distance must be at least 1 KM');
                return false;
            } else {
                removeRedBorder(distanceInput);
                removeFieldError(distanceInput);
                return true;
            }
        }

        function validateAll() {
            const isFullNameValid = validateField(fullNameInput, 'Full name');
            const isAddressValid = validateField(addressInput, 'Address');
            const isDistanceValid = validateDistance();
            const isPhoneValid = validatePhone();
            const isPasswordValid = validatePassword();

            const isValid = isFullNameValid && isAddressValid && isDistanceValid && isPhoneValid && isPasswordValid;

            if (isValid) {
                errorBox.classList.remove('hidden');
                errorBox.classList.add('success-color');
                errorMessage.textContent = 'Everything looks good!';
                errorIcon.className = 'fas fa-check-circle';
            } else {
                errorBox.classList.remove('hidden');
                errorBox.classList.remove('success-color');
                errorMessage.textContent = 'Please fix the errors below';
                errorIcon.className = 'fas fa-circle-exclamation';
            }
            
            return isValid;
        }

        // Toggle Password visibility
        if (togglePassword) {
            togglePassword.addEventListener('click', () => {
                const type = passwordField.type === 'password' ? 'text' : 'password';
                passwordField.type = type;
                togglePassword.classList.toggle('fa-eye-slash');
            });
        }

        // Real-time validation on input
        fullNameInput.addEventListener('input', () => validateField(fullNameInput, 'Full name'));
        addressInput.addEventListener('input', () => validateField(addressInput, 'Address'));
        distanceInput.addEventListener('input', validateDistance);
        phoneInput.addEventListener('input', validatePhone);
        passwordField.addEventListener('input', validatePassword);

        // Final Submit Check
        editForm.addEventListener('submit', (e) => {
            if (!validateAll()) {
                e.preventDefault();
                // Scroll to first error
                const firstError = document.querySelector('input[style*="border: 1px solid #dc2626"]');
                if (firstError) {
                    firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            }
        });
      });