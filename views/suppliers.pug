doctype html
html
  head
    title Supplier Dashboard
    link(rel='stylesheet' href='/css/suppliers.css') 
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css')
  body
    .sidebar
      .logo
        | ⚒ NYONDO HARDWARE
      ul
        li
          a(href='admindash')
            i.fas.fa-home
            |  Dashboard
        li
          a(href='deposit')
            i.fas.fa-cash-register
            |  Deposit
        li
          a(href='addstock')
            i.fas.fa-box
            |  Add Stock
        li
          a(href='suppliers').active
            i.fas.fa-truck-loading
            |  Suppliers
        li
          a(href='logout')
            i.fas.fa-sign-out-alt
            |  Logout
    .main
      h1 Supplier Credit Management
    
      .dashboard-stats
        .card.stat-qty
          h3 Pending Quantities
          p.stat-value #{stats.totalPendingQty || 0}
        
        .card.stat-items
          h3 Items on Credit
          p.stat-value #{stats.totalPendingItems || 0}
        
        .card.stat-debt
          h3 Total Debt (UGX)
          //- Added (|| 0) safety check to prevent the toLocaleString crash
          p.stat-value #{(stats.totalPendingDebt || 0).toLocaleString()}

      table.supplier-table
        thead
          tr
            th #
            th Supplier Name
            th Contact
            th Products
            th Factories
            th Total Debt (UGX)
            //- th Date
            th Status
            th Actions
        tbody
          if supplierDebts && supplierDebts.length > 0
            each sup, index in supplierDebts
              tr
                td #{index + 1}
                td #{sup.supplierName}
                td #{sup.contact}
                td 
                  ul(style="list-style: none; padding: 0; margin: 0;")
                    each prod in sup.productsSupplied
                      li(style="font-size: 0.85em; color: #444;") • #{prod}
                td 
                  ul(style="list-style: none; padding: 0; margin: 0;")
                    each fact in sup.factoriesSupplied
                      li(style="font-size: 0.8em; color: #666; font-style: italic;") 
                        i.fas.fa-industry 
                        |  #{fact}
                td #{sup.totalDebt.toLocaleString()}
                //- td #{new Date(sup.date).toLocaleString()}
                td
                  //- If pendingCount > 0, there is still debt to pay
                  if sup.pendingCount > 0
                    span.status-pending(style="color: orange; font-weight: bold;") Pending
                  else
                    span.status-paid(style="color: green; font-weight: bold;") Paid
                td.actions
              
                  if sup.pendingCount > 0
                      form(action=`/pay-supplier/${sup.supplierName}`, method="POST" style="display:inline;")
                        input(type="hidden" name="batchId" value=sup.paymentBatchId)
                        button.btn-action.btn-pay(type="submit" onclick=`return confirm("Confirm payment for ${sup.supplierName}?")`)
                          i.fas.fa-check-circle
                          |  Pay
                
                  //- Evidence link isolates the specific batch
                  a.btn-action.btn-evidence(href=`/evidence/${sup.supplierName}?batchId=${sup.paymentBatchId}`, target="_blank")
                    i.fas.fa-file-alt
                    |  Evidence
          else
            tr
              td(colspan='8' style="text-align:center;") No supplier records found.