doctype html
html
  head
    title Supplier Dashboard
    link(rel='stylesheet' href='/css/suppliers.css') 
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css')
  body
    // ================= SIDEBAR =================
    .sidebar
      .logo
        | ⚒ NYONDO HARDWARE
      ul
        li
          a(href='admidash')
            i.fas.fa-home
            |  Dashboard
        li
          a(href='deposit')
            i.fas.fa-cash-register
            |  Deposit
        li
          a(href='addstock')
            i.fas.fa-box
            |  Add Stock
        li
          a(href='suppliers').active
            i.fas.fa-truck-loading
            |  Suppliers
        li
          a(href='logout')
            i.fas.fa-sign-out-alt
            |  Logout

    // ================= MAIN CONTENT =================
    .main
      h1 Supplier Credit Management
      
      // ================= SUMMARY CARDS =================
      .dashboard-stats
        .card.stat-qty
          h3 Pending Quantities
          p.stat-value #{stats.totalPendingQty}
        
        .card.stat-items
          h3 Items on Credit
          p.stat-value #{stats.totalPendingItems}
        
        .card.stat-debt
          h3 Total Debt (UGX)
          p.stat-value #{stats.totalPendingDebt.toLocaleString()}

      // ================= SUPPLIER TABLE =================
      table.supplier-table
        thead
          tr
            th Supplier Name
            th Contact
            th Products
            th Factories
            th Total Debt (UGX)
            th Status
            th Actions
        tbody
          if supplierDebts && supplierDebts.length > 0
            each sup in supplierDebts
              tr
                td #{sup._id}
                td #{sup.contact}
                td 
                  // Displaying the array of unique product names
                  ul(style="list-style: none; padding: 0; margin: 0;")
                    each prod in sup.productsSupplied
                      li(style="font-size: 0.85em; color: #444;") • #{prod}
                td 
                  // Displaying the array of unique factory names
                  ul(style="list-style: none; padding: 0; margin: 0;")
                    each fact in sup.factoriesSupplied
                      li(style="font-size: 0.8em; color: #666; font-style: italic;") 
                        i.fas.fa-industry 
                        |  #{fact}
                td #{sup.totalDebt.toLocaleString()}
                td
                  if sup.totalDebt > 0
                    span.status-pending(style="color: orange; font-weight: bold;") Pending
                  else
                    span.status-paid(style="color: green; font-weight: bold;") Paid
                td.actions
                  //- ONLY show Pay button if debt is greater than 0
                  if sup.totalDebt > 0
                    form(action=`/pay-supplier/${sup._id}`, method="POST" style="display:inline;")
                      button.btn-action.btn-pay(type="submit" onclick='return confirm("Confirm payment for ' + sup._id + '?")')
                        i.fas.fa-check-circle
                        |  Pay
                  
                  //- Evidence button is always visible
                  a.btn-action.btn-evidence(href=`evidence/${sup._id}`, target="_blank")
                    i.fas.fa-file-alt
                    |  Evidence
          else
            tr
              td(colspan='7' style="text-align:center;") No suppliers found.